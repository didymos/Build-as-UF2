{
  "name": "uf2export-spike",
  "displayName": "UF2 Export Spike (throwaway)",
  "publisher": "uf2export",
  "version": "0.0.3",
  "description": "Phase 0 probe for Arduino IDE 2.x. Logs to OutputChannel 'UF2 Spike'. Not for release.",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "uf2spike.probe",
        "title": "UF2 Spike: Probe",
        "icon": "$(package)"
      },
      {
        "command": "uf2spike.verify",
        "title": "UF2 Spike: Run IDE verify and measure"
      },
      {
        "command": "uf2spike.dumpApi",
        "title": "UF2 Spike: Dump arduino API state"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "uf2spike.probe",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "uf2spike.probe",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u"
      }
    ]
  }
}
